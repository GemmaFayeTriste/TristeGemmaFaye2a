
:root {
  --bg: #071426;
  --bg-soft: #0b1c33;
  --card: #10243d;
  --card-light: #142b47;
  --text: #f0f6ff;
  --muted: #a7bad1;
  --accent: #38bdf8;
  --accent-2: #818cf8;
  --border: rgba(148, 185, 225, 0.17);
  --radius: 20px;
}

* {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
}

html {
  scroll-behavior: smooth;
  scroll-padding-top: 90px;
}

body {
  min-height: 100vh;
  font-family: Inter, "Segoe UI", Arial, sans-serif;
  background:
    radial-gradient(ellipse at 80% 0%, #112c4b 0%, transparent 38%),
    var(--bg);
  color: var(--text);
  line-height: 1.7;
}

a {
  color: inherit;
  text-decoration: none;
}

button, a {
  -webkit-tap-highlight-color: transparent;
}

.navbar {
  position: sticky;
  top: 0;
  z-index: 10;
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 24px;
  padding: 18px 7%;
  background: rgba(7, 20, 38, 0.9);
  backdrop-filter: blur(16px);
  border-bottom: 1px solid var(--border);
}

.logo {
  font-size: 1.65rem;
  font-weight: 850;
  letter-spacing: -1px;
}

.logo span,
h1 span,
h2 span {
  color: var(--accent);
}

nav {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 22px;
}

nav a {
  font-size: 0.9rem;
  color: var(--muted);
  transition: color 0.2s;
}

nav a:hover,
nav a:focus-visible {
  color: var(--accent);
}

.section {
  width: min(1120px, 86%);
  margin: 0 auto;
  padding: 95px 0;
}

.hero {
  min-height: 650px;
  display: grid;
  grid-template-columns: 1.25fr 0.75fr;
  align-items: center;
  gap: 65px;
}

.eyebrow {
  color: var(--accent);
  font-size: 0.76rem;
  font-weight: 800;
  letter-spacing: 2.4px;
  margin-bottom: 14px;
}

h1 {
  font-size: clamp(2.4rem, 5vw, 4.5rem);
  line-height: 1.13;
  letter-spacing: -2px;
  margin-bottom: 18px;
}

h2 {
  line-height: 1.25;
}

.hero-content > h2 {
  font-size: 1.25rem;
  color: #c2d6ed;
  font-weight: 500;
  margin-bottom: 20px;
}

.intro {
  color: var(--muted);
  max-width: 600px;
  margin-bottom: 28px;
}

.hero-buttons {
  display: flex;
  flex-wrap: wrap;
  gap: 12px;
  margin-bottom: 30px;
}

.btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 12px 19px;
  border-radius: 10px;
  font-weight: 750;
  font-size: 0.9rem;
  transition: transform 0.2s, background 0.2s;
}

.btn:hover {
  transform: translateY(-3px);
}

.primary {
  background: var(--accent);
  color: #061426;
}

.primary:hover {
  background: #7dd3fc;
}

.secondary {
  border: 1px solid var(--border);
  background: var(--card);
}

.secondary:hover {
  background: var(--card-light);
}

.clock-card {
  max-width: 370px;
  padding: 16px 19px;
  border: 1px solid var(--border);
  border-radius: 14px;
  background: rgba(16, 36, 61, 0.72);
}

.clock-label {
  display: block;
  font-size: 0.7rem;
  letter-spacing: 1.5px;
  color: var(--muted);
  margin-bottom: 3px;
}

#live-time {
  display: block;
  font-size: 1.7rem;
  font-weight: 800;
  font-variant-numeric: tabular-nums;
  color: var(--accent);
}

#live-date {
  font-size: 0.85rem;
  color: var(--muted);
}

.profile-wrap {
  position: relative;
  width: min(100%, 350px);
  justify-self: center;
  text-align: center;
}

.profile-glow {
  position: absolute;
  inset: 5% -8%;
  background: linear-gradient(140deg, var(--accent), var(--accent-2));
  filter: blur(65px);
  opacity: 0.22;
  border-radius: 50%;
}

.profile-photo,
.profile-placeholder {
  position: relative;
  width: 280px;
  height: 340px;
  max-width: 100%;
  margin: auto;
  border: 2px solid rgba(56, 189, 248, 0.65);
  border-radius: 48% 48% 25px 25px;
  box-shadow: 0 20px 65px rgba(0, 0, 0, 0.28);
}

.profile-photo {
  display: none;
  object-fit: cover;
  object-position: center;
}

.profile-placeholder {
  display: grid;
  place-items: center;
  background: linear-gradient(145deg, #173b60, #101d3c);
  font-size: 4rem;
  font-weight: 900;
  letter-spacing: 4px;
  color: var(--accent);
}

.profile-caption {
  position: relative;
  display: inline-flex;
  align-items: center;
  gap: 9px;
  margin-top: 20px;
  padding: 10px 15px;
  border-radius: 999px;
  border: 1px solid var(--border);
  background: var(--card);
  font-size: 0.82rem;
  color: #d4e5f7;
}

.status-dot {
  width: 8px;
  height: 8px;
  border-radius: 50%;
  background: #4ade80;
}

.section-heading {
  text-align: center;
  max-width: 650px;
  margin: 0 auto 40px;
}

.section-heading h2 {
  font-size: clamp(2rem, 4vw, 3rem);
  margin-bottom: 13px;
}

.section-heading > p:last-child {
  color: var(--muted);
}

.about-card,
.education-card,
.talent-card,
.project-card {
  background: linear-gradient(145deg, var(--card), rgba(11, 28, 51, 0.85));
  border: 1px solid var(--border);
  border-radius: var(--radius);
  transition: transform 0.25s, border-color 0.25s;
}

.about-card {
  display: grid;
  grid-template-columns: auto 1fr;
  gap: 22px;
  padding: 32px;
}

.about-icon,
.card-icon,
.education-icon {
  display: grid;
  place-items: center;
  width: 55px;
  height: 55px;
  border-radius: 15px;
  background: rgba(56, 189, 248, 0.11);
  font-size: 1.7rem;
}

.about-card h3,
.education-card h3,
.talent-card h3,
.project-card h3 {
  font-size: 1.2rem;
  margin-bottom: 9px;
}

.about-card p,
.education-card p,
.talent-card p,
.project-card p {
  color: var(--muted);
  font-size: 0.95rem;
}

.about-card p + p {
  margin-top: 14px;
}

.education-card {
  display: flex;
  gap: 24px;
  align-items: flex-start;
  max-width: 780px;
  margin: auto;
  padding: 30px;
}

.education-card:hover,
.talent-card:hover,
.project-card:hover {
  transform: translateY(-5px);
  border-color: rgba(56, 189, 248, 0.5);
}

.tag {
  display: inline-block;
  font-size: 0.68rem;
  font-weight: 800;
  letter-spacing: 1px;
  color: var(--accent);
  margin-bottom: 10px;
}

.education-card h4 {
  color: #c2d6ed;
  font-weight: 500;
  margin-bottom: 8px;
}

.education-card .muted {
  margin-bottom: 12px;
}

.talent-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 20px;
}

.talent-card {
  padding: 25px;
}

.card-icon {
  margin-bottom: 18px;
}

.talent-card p {
  line-height: 1.8;
}

.project-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 20px;
}

.project-card {
  display: flex;
  flex-direction: column;
  padding: 25px;
  min-height: 235px;
}

.project-number {
  font-size: 0.75rem;
  letter-spacing: 2px;
  color: var(--accent);
  font-weight: 800;
  margin-bottom: 15px;
}

.project-card p {
  flex: 1;
  margin-bottom: 20px;
}

.project-link {
  align-self: flex-start;
  color: var(--accent);
  font-weight: 750;
  font-size: 0.9rem;
}

.project-link:hover {
  color: #bae6fd;
}

.project-status {
  text-align: center;
  margin-top: 18px;
  font-size: 0.85rem;
}

.muted {
  color: var(--muted);
}

.contact-section {
  text-align: center;
  padding-bottom: 100px;
}

.contact-section .section-heading {
  margin-bottom: 25px;
}

.footer {
  padding: 25px 7%;
  display: flex;
  justify-content: space-between;
  gap: 15px;
  flex-wrap: wrap;
  border-top: 1px solid var(--border);
  color: var(--muted);
  font-size: 0.82rem;
}

:focus-visible {
  outline: 2px solid var(--accent);
  outline-offset: 4px;
}

@media (max-width: 850px) {
  .navbar {
    padding: 15px 5%;
    flex-direction: column;
    gap: 10px;
  }

  nav {
    justify-content: center;
    gap: 12px 18px;
  }

  .hero {
    grid-template-columns: 1fr;
    text-align: center;
    gap: 40px;
    padding-top: 65px;
  }

  .intro {
    margin-left: auto;
    margin-right: auto;
  }

  .hero-buttons {
    justify-content: center;
  }

  .clock-card {
    margin: auto;
    text-align: left;
  }

  .profile-wrap {
    grid-row: 1;
  }

  .talent-grid,
  .project-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
}

@media (max-width: 560px) {
  .section {
    width: 90%;
    padding: 65px 0;
  }

  h1 {
    font-size: 2.55rem;
    letter-spacing: -1.3px;
  }

  .hero-content > h2 {
    font-size: 1.05rem;
  }

  .profile-photo,
  .profile-placeholder {
    width: 225px;
    height: 270px;
  }

  .talent-grid,
  .project-grid {
    grid-template-columns: 1fr;
  }

  .about-card {
    grid-template-columns: 1fr;
    padding: 23px;
  }

  .education-card {
    flex-direction: column;
    padding: 23px;
  }

  .footer {
    flex-direction: column;
    text-align: center;
  }

  .hero-buttons .btn {
    width: 100%;
  }
}

@media (prefers-reduced-motion: reduce) {
  *,
  *::before,
  *::after {
    scroll-behavior: auto !important;
    transition: none !important;
  }
}
