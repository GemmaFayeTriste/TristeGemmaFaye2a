
"use strict";

// Live local date and time
function updateClock() {
  const now = new Date();

  const timeElement = document.getElementById("live-time");
  const dateElement = document.getElementById("live-date");
  const yearElement = document.getElementById("current-year");

  if (timeElement) {
    timeElement.textContent = now.toLocaleTimeString(undefined, {
      hour: "2-digit",
      minute: "2-digit",
      second: "2-digit",
      hour12: true
    });
  }

  if (dateElement) {
    dateElement.textContent = now.toLocaleDateString(undefined, {
      weekday: "long",
      year: "numeric",
      month: "long",
      day: "numeric"
    });
  }

  if (yearElement) {
    yearElement.textContent = now.getFullYear();
  }
}

updateClock();
setInterval(updateClock, 1000);

// Profile image support
const profilePhoto = document.getElementById("profile-photo");
const profilePlaceholder = document.getElementById("profile-placeholder");

if (profilePhoto && profilePlaceholder) {
  profilePhoto.addEventListener("load", () => {
    profilePhoto.style.display = "block";
    profilePlaceholder.style.display = "none";
  });

  profilePhoto.addEventListener("error", () => {
    profilePhoto.style.display = "none";
    profilePlaceholder.style.display = "grid";
  });

  // Also handles an image that loaded before this script ran.
  if (profilePhoto.complete && profilePhoto.naturalWidth > 0) {
    profilePhoto.style.display = "block";
    profilePlaceholder.style.display = "none";
  }
}

// Check project URLs before making them clickable.
function safeProjectURL(value) {
  try {
    const url = new URL(value);

    if (url.protocol === "https:" || url.protocol === "http:") {
      return url.href;
    }
  } catch {
    // An invalid URL will be shown without a clickable link.
  }

  return null;
}

// Build project cards from projects.json.
async function loadProjects() {
  const grid = document.getElementById("project-grid");
  const status = document.getElementById("project-status");

  if (!grid) return;

  try {
    const response = await fetch("projects.json");

    if (!response.ok) {
      throw new Error("Could not load projects.json");
    }

    const data = await response.json();

    if (!Array.isArray(data.projects)) {
      throw new Error("The projects list is not valid.");
    }

    grid.replaceChildren();

    if (data.projects.length === 0) {
      grid.textContent = "No projects added yet. Check back soon!";
      return;
    }

    data.projects.forEach((project, index) => {
      const card = document.createElement("article");
      card.className = "project-card";

      const number = document.createElement("span");
      number.className = "project-number";
      number.textContent = `PROJECT ${(index + 1)
        .toString().padStart(2, "0")}`;

      const title = document.createElement("h3");
      title.textContent = project.title || "Untitled Project";

      const description = document.createElement("p");
      description.textContent =
        project.description || "Project description coming soon.";

      card.append(number, title, description);

      const url = safeProjectURL(project.url);

      if (url) {
        const link = document.createElement("a");
        link.className = "project-link";
        link.href = url;
        link.target = "_blank";
        link.rel = "noopener noreferrer";
        link.textContent = "View Project ↗";
        link.setAttribute(
          "aria-label",
          `View ${project.title || "project"} in a new tab`
        );

        card.appendChild(link);
      } else {
        const note = document.createElement("span");
        note.className = "muted";
        note.textContent = "Project link not added yet.";
        card.appendChild(note);
      }

      grid.appendChild(card);
    });

    if (status) {
      status.textContent =
        "Project links open in a new tab. Replace example URLs with your real projects.";
    }
  } catch (error) {
    console.error("Project loading error:", error);

    grid.replaceChildren();

    const message = document.createElement("p");
    message.className = "muted";
    message.textContent =
      "Projects could not be loaded. Please run this website using a local web server and check projects.json.";

    grid.appendChild(message);
  }
}

loadProjects();
